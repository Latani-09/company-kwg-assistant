DATABASE_URL=postgresql+psycopg://kwg:kwg@localhost:5432/kwg_assistant
GEMINI_API_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
RAG_SIMILARITY_FLOOR=0.55
RAG_TOP_K=5
# SendGrid SMTP relay — https://app.sendgrid.com/settings/api_keys
# SMTP_USERNAME is always the literal string "apikey"; SMTP_PASSWORD is your SendGrid API key.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
# Deployed frontend origin, used to build deep links in emails (e.g. gap assignment).
APP_BASE_URL=
